{
  "name": "yusagent",
  "displayName": "yusAgent",
  "description": "Agent de code yusAgent dans VS Code (ACP). Base : l'extension d'Unharnessed (MIT). Binaire installé à part.",
  "version": "0.1.0",
  "publisher": "yusagent",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/YusufByn/yusagent.git",
    "directory": "extensions/vscode"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "yusagent.open",
        "title": "Ouvrir yusAgent",
        "category": "yusAgent",
        "icon": "media/icon.svg"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "yusagent.open",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "yusagent",
          "title": "yusAgent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "yusagent": [
        {
          "type": "webview",
          "id": "yusagent.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "yusAgent",
      "properties": {
        "yusagent.binaryPath": {
          "type": "string",
          "default": "yusagent",
          "scope": "machine",
          "markdownDescription": "Chemin du binaire `yusagent` (nom seul : cherché dans le `PATH`). Le binaire n'est pas dans l'extension. Réglage utilisateur seulement : un workspace ne peut pas choisir le binaire lancé."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "lint": "eslint .",
    "compile-tests": "tsc -p tsconfig.json --outDir out",
    "test:unit": "npm run compile-tests && node --require ./out/test/unit/setup.js --test --test-timeout=60000 \"out/test/unit/**/*.test.js\"",
    "test:e2e": "npm run build && npm run compile-tests && node out/test/e2e/run.js",
    "package": "npm run build && vsce package --no-dependencies --out yusagent.vsix && node scripts/check-size.mjs yusagent.vsix"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.110.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
